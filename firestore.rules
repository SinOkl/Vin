rules_version = '2';
// Lim inn i Firebase Console → Firestore Database → Rules → Publish.
//
// Modell:
//   kjellere/{kjellerId}                { navn, eierUid, inviteKode, medlemmer: [uid, ...], opprettet }
//   kjellere/{kjellerId}/viner/{vinId}   selve vin-/brennevindataen
//
// Alle innloggede kan lese kjeller-metadata (navngir og invitasjonskoder) — nødvendig
// for at "bli med via kode"-oppslaget skal fungere. Selve vinlisten er derimot kun
// synlig for medlemmer. Passer for en liten, tillitsfull venne-/familiegruppe — ikke
// tenkt som hardnet flerbrukers-SaaS-sikkerhet.

service cloud.firestore {
  match /databases/{database}/documents {

    function innlogget() {
      return request.auth != null;
    }

    function erMedlemAv(kjellerId) {
      return innlogget() &&
        request.auth.uid in get(/databases/$(database)/documents/kjellere/$(kjellerId)).data.medlemmer;
    }

    // Sant kun når den eneste endringen er at innlogget bruker legger til seg selv i medlemmer-lista.
    function kunLaTilSegSelv(gammel, ny) {
      return ny.medlemmer.size() == gammel.medlemmer.size() + 1 &&
        !(request.auth.uid in gammel.medlemmer) &&
        (request.auth.uid in ny.medlemmer) &&
        ny.navn == gammel.navn &&
        ny.eierUid == gammel.eierUid &&
        ny.inviteKode == gammel.inviteKode;
    }

    // Sant kun når den eneste endringen er at innlogget bruker fjerner seg selv (forlater kjelleren).
    function kunFjernetSegSelv(gammel, ny) {
      return ny.medlemmer.size() == gammel.medlemmer.size() - 1 &&
        (request.auth.uid in gammel.medlemmer) &&
        !(request.auth.uid in ny.medlemmer) &&
        ny.navn == gammel.navn &&
        ny.eierUid == gammel.eierUid &&
        ny.inviteKode == gammel.inviteKode;
    }

    match /kjellere/{kjellerId} {
      allow read: if innlogget();

      allow create: if innlogget()
        && request.resource.data.eierUid == request.auth.uid
        && request.resource.data.medlemmer == [request.auth.uid];

      allow update: if innlogget() && (
        resource.data.eierUid == request.auth.uid ||
        kunLaTilSegSelv(resource.data, request.resource.data) ||
        kunFjernetSegSelv(resource.data, request.resource.data)
      );

      allow delete: if innlogget() && resource.data.eierUid == request.auth.uid;

      match /viner/{vinId} {
        allow read, write: if erMedlemAv(kjellerId);
      }
    }
  }
}
