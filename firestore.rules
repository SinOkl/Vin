rules_version = '2';
// Lim inn i Firebase Console → Firestore Database → Rules → Publish.
//
// Modell:
//   invitasjoner/{inviteKode}           { kjellerId }  — kun oppslåbar med eksakt kjent kode, aldri listbar
//   kjellere/{kjellerId}                { navn, eierUid, inviteKode, medlemmer: [uid, ...], opprettet }
//   kjellere/{kjellerId}/viner/{vinId}   selve vin-/brennevindataen
//   produkter/{ean}                     delt strekkode-cache — produktfakta, ikke kjeller-spesifikk
//
// Kun medlemmer av en kjeller kan lese/liste dens metadata og vinliste — ingen kan
// bla gjennom andres kjellere. "Bli med via kode"-flyten går via invitasjoner/-
// samlingen, som kun kan slås opp med eksakt kjent kode (aldri listet ut).
// produkter/-samlingen er delt på tvers av alle kjellere med vilje (poenget er at
// alle som bruker appen skal få nytte av at noen andre har identifisert samme
// strekkode), og er derfor lesbar/skrivbar for alle innloggede, ikke bare egne
// medlemmer — det er ikke persondata, kun objektive vin-/brennevinfakta.
// Passer for en liten, tillitsfull venne-/familiegruppe — ikke tenkt som hardnet
// flerbrukers-SaaS-sikkerhet.

service cloud.firestore {
  match /databases/{database}/documents {

    function innlogget() {
      return request.auth != null;
    }

    function erMedlemAv(kjellerId) {
      return innlogget() &&
        request.auth.uid in get(/databases/$(database)/documents/kjellere/$(kjellerId)).data.medlemmer;
    }

    // Sant kun når medlemmer-lista endres ved at innlogget bruker legger til akkurat
    // seg selv, uten at noe annet i lista eller resten av dokumentet endres.
    function kunLaTilSegSelv(gammel, ny) {
      return ny.medlemmer.removeAll(gammel.medlemmer) == [request.auth.uid] &&
        gammel.medlemmer.removeAll(ny.medlemmer).size() == 0 &&
        ny.navn == gammel.navn &&
        ny.eierUid == gammel.eierUid &&
        ny.inviteKode == gammel.inviteKode;
    }

    // Sant kun når medlemmer-lista endres ved at innlogget bruker fjerner akkurat
    // seg selv (forlater kjelleren), uten at noe annet endres.
    function kunFjernetSegSelv(gammel, ny) {
      return gammel.medlemmer.removeAll(ny.medlemmer) == [request.auth.uid] &&
        ny.medlemmer.removeAll(gammel.medlemmer).size() == 0 &&
        ny.navn == gammel.navn &&
        ny.eierUid == gammel.eierUid &&
        ny.inviteKode == gammel.inviteKode;
    }

    // Kun oppslåbar med eksakt kjent kode (get), aldri gjennombla-bar (list).
    match /invitasjoner/{kode} {
      allow get: if innlogget();
      allow list: if false;
      allow create: if innlogget();
      allow update: if false;
      allow delete: if innlogget() &&
        get(/databases/$(database)/documents/kjellere/$(resource.data.kjellerId)).data.eierUid == request.auth.uid;
    }

    match /kjellere/{kjellerId} {
      allow get: if innlogget() && request.auth.uid in resource.data.medlemmer;
      allow list: if innlogget() && request.auth.uid in resource.data.medlemmer;

      allow create: if innlogget()
        && request.resource.data.eierUid == request.auth.uid
        && request.resource.data.medlemmer == [request.auth.uid];

      allow update: if innlogget() && (
        resource.data.eierUid == request.auth.uid ||
        kunLaTilSegSelv(resource.data, request.resource.data) ||
        kunFjernetSegSelv(resource.data, request.resource.data)
      );

      allow delete: if innlogget() && resource.data.eierUid == request.auth.uid;

      match /viner/{vinId} {
        allow read, write: if erMedlemAv(kjellerId);
      }
    }

    // Delt strekkode-cache. EAN-en er selve dokument-ID-en, ikke et felt — derfor er
    // "get" (oppslag på kjent EAN) trygt å åpne for alle innloggede uten å avsløre
    // noe man ikke allerede vet (samme prinsipp som invitasjoner/, se over).
    match /produkter/{ean} {
      allow get: if innlogget();
      allow list: if false;
      allow create, update: if innlogget();
      allow delete: if false;
    }
  }
}
